DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kotaana?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/kotaana?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI is enhancement-only; workout safety and nutrition selection remain database/rule driven.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="deepseek/deepseek-chat-v3.1"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional weather provider is public Open-Meteo; no key required.

# MoMo Collections. Set these for live payments; internal approval workflow works without provider credentials.
MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MOMO_TARGET_ENVIRONMENT="sandbox"
MOMO_SUBSCRIPTION_KEY=""
MOMO_API_USER=""
MOMO_API_KEY=""
MOMO_CURRENCY="RWF"
KOTAANA_PLATFORM_MOMO_CODE=""

# Optional email service for password reset verification.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""

# Image storage. Use "database" for small uploads or "s3"/R2 in production.
STORAGE_DRIVER="database"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

ADMIN_BOOTSTRAP_PASSWORD=""
RESEND_API_KEY=""
